#!/usr/bin/python3
"""Private TCP bridge to the user's HTTP proxy, pinned to physical egress."""
import json
import os
import sys
import socket
import socketserver
import subprocess
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'scripts'))
from common import HOME, load_proxy
ROOT = HOME / 'data'
ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
relay = json.loads((HOME / 'relay-config.json').read_text())
proxy = load_proxy()
lock=threading.Lock()
stats={'listen':'127.0.0.1:' + str(relay['port']),'connected':0,'failed':0,'active':0,
       'vpn_bypass_verified':0,'bytes_up':0,'bytes_down':0}

def update(**values):
    with lock:
        for k,v in values.items():stats[k]=stats.get(k,0)+v

def physical_socket():
    routes=json.loads(subprocess.check_output(['ip','-j','route','show','table','main','default'],stderr=subprocess.DEVNULL))
    for route in routes:
        device=route.get('dev','')
        if not device or device.startswith(('tun','tap','wg','tailscale')):continue
        addresses=json.loads(subprocess.check_output(['ip','-j','-4','addr','show','dev',device],stderr=subprocess.DEVNULL))
        sources=[a['local'] for item in addresses for a in item.get('addr_info',[]) if a['family']=='inet' and a.get('scope')=='global']
        if not sources:continue
        source=sources[0]
        for entry in socket.getaddrinfo(proxy['host'],proxy['port'],socket.AF_INET,socket.SOCK_STREAM):
            target=entry[4]
            selected=json.loads(subprocess.check_output(['ip','-j','route','get',target[0],'from',source,'oif',device],stderr=subprocess.DEVNULL))[0]
            if selected.get('dev')!=device or selected.get('table','main') not in ['main',254]:continue
            stream=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
            try:
                stream.setsockopt(socket.SOL_SOCKET,socket.SO_BINDTODEVICE,(device+'\0').encode())
                stream.bind((source,0));stream.settimeout(12);stream.connect(target);stream.settimeout(None)
                if stream.getsockname()[0]!=source:raise RuntimeError('Unexpected source')
                with lock:stats['physical_device']=device
                return stream
            except Exception:
                stream.close()
    raise RuntimeError('No verified physical route')

class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        upstream=None
        try:
            upstream=physical_socket();update(connected=1,active=1,vpn_bypass_verified=1)
            def pump(source,target,key):
                try:
                    while True:
                        data=source.recv(65536)
                        if not data:break
                        target.sendall(data);update(**{key:len(data)})
                except OSError:pass
                finally:
                    for stream in [source,target]:
                        try:stream.shutdown(socket.SHUT_RDWR)
                        except OSError:pass
            other=threading.Thread(target=pump,args=(upstream,self.request,'bytes_down'),daemon=True)
            other.start();pump(self.request,upstream,'bytes_up');other.join(timeout=2)
        except Exception as error:
            update(failed=1)
            with lock:stats['last_error_type']=type(error).__name__
        finally:
            if upstream:
                upstream.close();update(active=-1)

class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address=True
    daemon_threads=True
    def handle_error(self,request,address):
        update(failed=1)

def publish():
    while True:
        with lock:payload=dict(stats)
        temp=ROOT/'direct-relay-status.tmp'
        temp.write_text(json.dumps(payload,indent=2)+'\n');temp.chmod(0o600)
        temp.replace(ROOT/'direct-relay-status.json')
        time.sleep(2)

try:
    threading.Thread(target=publish,daemon=True).start()
    Server(('127.0.0.1', relay['port']),Handler).serve_forever()
except Exception as error:
    print(json.dumps({'relay_error_type':type(error).__name__}),flush=True)
    raise SystemExit(1)
